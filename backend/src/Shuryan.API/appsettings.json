{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=GraduationProjectDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Paymob": {
    "APIKey": "",
    "PublicKey": "",
    "SecretKey": "",
    "HMAC": "",
    "CardIntegrationId": "",
    "MobileIntegrationId": "",
    "BaseUrl": "https://accept.paymob.com/api",
    "IFrameUrl": "https://accept.paymob.com/api/acceptance/iframes",
    "TimeoutSeconds": 30
  },

  "JwtSettings": {
    "Issuer": "http://localhost:5000",
    "Audience": "http://localhost:3000",
    "ExpiryInHours": 1,
    "SecretKey": "ThisIsASecretKeyForJwtToken_MakeSureItIsLongEnough123$"
  },

  "AppSettings": {
    "AppName": "Graduation Project API",
    "Version": "1.0.0",
    "SupportEmail": "admin@project.com"
  },

  "CorsSettings": {
    "PolicyName": "AllowReactApp",
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": true
  }
}